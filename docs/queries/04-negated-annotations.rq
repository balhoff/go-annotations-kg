# NOT annotations: what curators say a gene product does not do.
# These triples are not asserted; only goann:negates reaches them.
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX goann: <https://w3id.org/go-annotation-kg/vocab/>

SELECT ?gp ?relation ?term ?code ?reference WHERE {
  ?annotation goann:negates <<( ?gp ?relation ?term )>> ;
              goann:evidenceCode ?code ;
              dcterms:source ?reference .
  ?gp obo:RO_0002162 obo:NCBITaxon_9606 .
}
LIMIT 100

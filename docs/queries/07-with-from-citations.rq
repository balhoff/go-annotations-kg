# Annotations that cite a protein in with/from: IPI annotations of its
# interaction partners, and IBA/ISS annotations that transferred function from it.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX goann: <https://w3id.org/go-annotation-kg/vocab/>
PREFIX UniProtKB: <http://purl.uniprot.org/uniprot/>

SELECT ?gp ?relation ?term ?code WHERE {
  ?annotation goann:withFrom UniProtKB:P04637 ;
              a goann:Annotation ;
              goann:evidenceCode ?code ;
              rdf:reifies <<( ?gp ?relation ?term )>> .
}

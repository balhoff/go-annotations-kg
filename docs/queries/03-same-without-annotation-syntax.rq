# The same as 02, written with an explicit triple term, for engines or clients
# that take triple-term patterns but not the {| |} shorthand.
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX goann: <https://w3id.org/go-annotation-kg/vocab/>
PREFIX UniProtKB: <http://purl.uniprot.org/uniprot/>

SELECT ?relation ?term ?code ?eco ?reference WHERE {
  ?annotation rdf:reifies <<( UniProtKB:P04637 ?relation ?term )>> ;
              a goann:Annotation ;
              goann:evidenceCode ?code ;
              obo:RO_0002558 ?eco ;
              dcterms:source ?reference .
  FILTER(?code != "IEA")
}

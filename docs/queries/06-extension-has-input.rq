# Annotations whose extension says the activity has input (RO:0002233) a given protein.
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX goann: <https://w3id.org/go-annotation-kg/vocab/>
PREFIX UniProtKB: <http://purl.uniprot.org/uniprot/>

SELECT ?gp ?relation ?term WHERE {
  ?annotation rdf:reifies <<( ?gp ?relation ?term )>> ;
              goann:extension ?extension .
  ?extension rdfs:subClassOf [ owl:onProperty obo:RO_0002233 ; owl:someValuesFrom UniProtKB:P04637 ] .
}
